{%- comment -%}
  LOCAL OVERRIDE, rebuilt to DESIGN.md §7. Upstream's `footer_fixed` branch is
  gone; `_config.yml` sets that key false to match.
{%- endcomment -%}

<footer class="site-footer" role="contentinfo">
  {%- if site.newsletter.enabled -%}
    {%- if site.plugins contains 'al_newsletter' -%}
      {% include plugins/al_newsletter_form_center.liquid %}
    {%- else -%}
      {% include newsletter.liquid %}
    {%- endif -%}
  {%- endif -%}

  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-logo" href="{{ '/' | relative_url }}">
        <span class="site-logo__dot" aria-hidden="true"></span>
        <span class="site-logo__name">
          {%- if site.title == 'blank' -%}
            {{- site.first_name }}
            {{ site.last_name -}}
          {%- else -%}
            {{- site.title -}}
          {%- endif -%}
        </span>
      </a>
      {%- comment -%}Upstream's credit line, kept deliberately.{%- endcomment -%}
      <p class="site-footer__meta">
        &copy; Copyright {{ site.time | date: '%Y' }}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}.
        {{ site.footer_text }}
        {%- if site.last_updated %} Last updated: {{ 'now' | date: '%B %d, %Y' }}.{% endif -%}
      </p>
    </div>

    {%- comment -%}Explicit list, not `{% social_links %}`: about and the footer want different sets.{%- endcomment -%}
    <nav class="site-footer__socials" aria-label="Contact">
      {%- if site.data.contact.email -%}
        {%- comment -%}Split address, joined by the script at the bottom of this file.{%- endcomment -%}
        {%- assign email_parts = site.data.contact.email | split: '@' -%}
        <a href="#" class="site-email" data-eu="{{ email_parts[0] }}" data-ed="{{ email_parts[1] }}" title="Email" aria-label="Email">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        </a>
        <noscript>
          <span class="site-email-fallback">{{ email_parts[0] }} [at] {{ email_parts[1] | replace: '.', ' [dot] ' }}</span>
        </noscript>
      {%- endif -%}

      {%- if site.data.socials.github_username -%}
        <a
          href="https://github.com/{{ site.data.socials.github_username }}"
          title="GitHub"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
        >
          <i class="fa-brands fa-github" aria-hidden="true"></i>
        </a>
      {%- endif -%}

      {%- if site.data.socials.linkedin_username -%}
        <a
          href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}"
          title="LinkedIn"
          aria-label="LinkedIn"
          target="_blank"
          rel="noopener"
        >
          <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
        </a>
      {%- endif -%}

      <a href="{{ '/feed.xml' | relative_url }}" title="RSS feed" aria-label="RSS feed">
        <i class="fa-solid fa-square-rss" aria-hidden="true"></i>
      </a>
    </nav>
  </div>

  {%- if site.impressum_path -%}
    <p class="site-footer__meta site-footer__impressum">
      <a href="{{ site.impressum_path | relative_url }}">Impressum</a>
    </p>
  {%- endif -%}
</footer>

{%- comment -%}Joins the halves of `.site-email` on click. Delegated, so about's icon is covered too.{%- endcomment -%}
<script>
  (function () {
    function openMail(element) {
      var user = element.getAttribute('data-eu');
      var domain = element.getAttribute('data-ed');
      if (!user || !domain) return;
      window.location.href = 'mailto:' + user + '@' + domain;
    }

    function activate(event) {
      var element = event.target.closest ? event.target.closest('.site-email') : null;
      if (!element) return;
      event.preventDefault();
      openMail(element);
    }

    document.addEventListener('click', activate);

    // Enter already fires click on <a>; Space does not.
    document.addEventListener('keydown', function (event) {
      if (event.key !== ' ' && event.key !== 'Spacebar') return;
      activate(event);
    });
  })();
</script>
