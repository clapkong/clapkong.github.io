{% comment %}
  Site copy of al_folio_cv's templates/cv/awards.liquid. Changed: an entry with a
  `semesters:` list shows how many ("4 sem.") in the badge and the list as chips under
  the summary; with a single semester the badge shows that semester ("Fall 2024") and
  there are no chips. Without `semesters:` the badge is the year, as in the gem.
{% endcomment %}
{% comment %}
  Unified awards entry renderer for both formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        {% comment %} `capture` keeps the surrounding whitespace, so strip before testing for emptiness {% endcomment %}
        {% capture start_date %}
          {% if entry.date %}{{ entry.date }}{% endif %}
        {% endcapture %}
        {% assign start_date = start_date | strip %}
        {% assign semester_count = entry.semesters | size %}
        {% if semester_count > 1 %}
          {% assign badge = semester_count | append: ' sem.' %}
        {% elsif semester_count == 1 %}
          {% assign badge = entry.semesters[0] %}
        {% elsif start_date != '' %}
          {% assign badge = start_date | split: '-' | slice: 0, 1 | join: '' %}
        {% else %}
          {% assign badge = '' %}
        {% endif %}

        {% if badge != '' %}
          <div class="col-xs-2 col-sm-2 col-md-2 text-center">
            <table class="table-cv">
              <tbody>
                <tr>
                  <td>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                      {{- badge -}}
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
            {% if entry.url %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">
                <a href="{{ entry.url }}">{{ entry.title }}</a>
              </h6>
            {% elsif entry.title %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.title }}</h6>
            {% endif %}

            {% if entry.awarder %}
              <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.awarder }}</h6>
            {% endif %}

            {% if entry.summary %}
              <p class="ml-1 ml-md-4">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            {% endif %}

            {% if semester_count > 1 %}
              <ul class="cv-chips ml-1 ml-md-4">
                {% for semester in entry.semesters %}
                  <li>{{ semester }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% else %}
          <div class="col-xs-12 col-sm-12 col-md-12">
            {% if entry.url %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">
                <a href="{{ entry.url }}">{{ entry.title }}</a>
              </h6>
            {% elsif entry.title %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.title }}</h6>
            {% endif %}

            {% if entry.awarder %}
              <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.awarder }}</h6>
            {% endif %}

            {% if entry.summary %}
              <p class="ml-1 ml-md-4">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
